Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: handeye_color_optical
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: Calibration Axes
      Enabled: true
      Marker Topic:
        Value: /moveit_visual_tools
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
    - Class: moveit_rviz_plugin/HandEyeCalibration
      Name: HandEyeCalibration
      Enabled: true
      Camera FOV Marker: false
      sensor_mount_type: 1
      target_type: HandEyeTarget/Charuco
      squares, X: 7
      squares, Y: 5
      marker size (px): 300
      square size (px): 400
      margin size (px): 0
      marker border (bits): 1
      ArUco dictionary: DICT_5X5_250
      longest board side (m): 0.280
      measured marker size (m): 0.030
      image_topic: /handeye/color/image_raw
      sensor: handeye_color_optical
      object: handeye_target
      eef: gripper_flange
      base: base_link
    - Class: rviz_default_plugins/Image
      Name: Board Detection
      Enabled: true
      Topic:
        Value: /handeye_calibration/target_detection
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
Window Geometry:
  Width: 1400
  Height: 900
