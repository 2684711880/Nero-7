Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: orbbec336l_color_optical
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Name: Calibration Axes
    Enabled: true
    Topic:
      Value: /moveit_visual_tools
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 10
  - Class: moveit_rviz_plugin/HandEyeCalibration
    Name: HandEyeCalibration
    Enabled: true
    Camera FOV Marker: false
    sensor_mount_type: 0
    target_type: HandEyeTarget/Aruco
    markers, X: 3
    markers, Y: 4
    first marker ID: 0
    marker size (px): 200
    marker separation (px): 20
    marker border (bits): 1
    ArUco dictionary: DICT_5X5_250
    measured marker size (m): 0.06
    measured separation (m): 0.006
    image_topic: /handeye/color/image_raw
    sensor: orbbec336l_color_optical
    object: handeye_target
    eef: gripper_flange
    base: base_link
  - Class: rviz_default_plugins/Image
    Name: ArUco Grid Detection
    Enabled: true
    Topic:
      Value: /handeye_calibration/target_detection
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
Window Geometry:
  Width: 1400
  Height: 900
