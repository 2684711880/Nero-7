// 水瓶搬运任务的注释版，内容逐项对应 bottle_transfer.json。
// 当前 submit_task 接收标准 JSON；执行时仍使用 bottle_transfer.json。
// 修改本注释版不会自动修改执行用的 .json，参数变更须同步到 .json。
//
// 执行规则：
// 1. 底盘、左臂、右臂是三条并行序列，每条内部按数组排列顺序执行。
// 2. action_id 是任务内唯一的标签，不是排序号；数字不连续也可以。
// 3. 当前动作开始 = 本序列前一步成功 + wait_for 中所有动作成功。
// 4. wait_for: [] 只表示没有额外依赖，不表示越过本序列前一步。
// 5. 相同 task_id、相同内容返回已有状态；内容变更需换新 task_id。
//
// 当前依赖链：
// 初始 b1/l1/r1 并行；右臂 r1→r2→r3→r4→r5→r7→r8。
// r3 额外等待 b1；b2 额外等待 r5；r7 额外等待 b2；b3 额外等待 r8。
{
  "version": 1,                          // 数据格式版本，不是机器人固件版本。
  "task_id": "bottle_transfer_004",       // 整个任务的唯一编号，用于反馈、查询、取消和去重。

  "base_actions": [                      // 底盘序列：按此处的排列顺序执行 b1 → b2 → b3。
    {
      "action_id": "b1",                 // 标签 b1：前往抓取停靠点。
      "type": "base_move_to",            // 底盘闭环移动到目标位置及朝向。
      "parameters": {                    // 本动作的参数对象。
        "frame_id": "odom",              // 目标使用 odom 场景坐标；当前底盘适配器只支持 odom。
        "position_xy_m": [0, -0.8],       // 绝对目标 [x,y]，单位 m；源桌位于场景负 Y 侧。
        "yaw_rad": 0,                    // 绝对目标朝向，单位 rad；0 为初始朝向。
        "via": []                        // 途经位姿列表为空，直接前往最终目标。
      },
      "wait_for": [],                    // 本序列第一步且无额外依赖，可在任务开始后启动。
      "timeout_s": 180                   // 动作实际开始后最多等待 180 s；不计等待依赖的时间。
    },
    {
      "action_id": "b2",                 // 标签 b2：把抓住的水瓶运到左桌。
      "type": "base_move_to",            // 同样使用底盘位置闭环。
      "parameters": {
        "frame_id": "odom",              // 固定场景坐标系。
        "position_xy_m": [0, 0.8],        // 最终停靠目标 [x,y]，单位 m；目标桌位于正 Y 侧。
        "yaw_rad": 3.141592653589793,     // 最终朝向 π rad = 180°。
        "via": [                         // 先依次走完这些途经位姿，再去最终停靠点。
          [0, 0, 0],                     // [x,y,yaw]：先回中央，保持初始朝向。
          [0, 0, 3.141592653589793]       // 在中央转到 180°，然后再向目标桌移动。
        ]
      },
      "wait_for": ["r5"],                // 除了等待前一步 b1，还要等右臂 r5 抬起成功。
      "timeout_s": 180                   // 整段途经路线与最终停靠共用 180 s。
    },
    {
      "action_id": "b3",                 // 标签 b3：放瓶后返回场景起点。
      "type": "base_move_to",            // 不含机械臂回零动作，只移动底盘。
      "parameters": {
        "frame_id": "odom",              // 当前场景预设的起点坐标，不是运行时采集的任意出发点。
        "position_xy_m": [0, 0],          // 最终返回 odom 原点。
        "yaw_rad": 0,                    // 最终恢复初始朝向。
        "via": [
          [0, 0, 3.141592653589793]       // 先保持 180° 朝向退回中央，再转回 0°。
        ]
      },
      "wait_for": ["r8"],                // 除了等待 b2，还必须等 r8 松开水瓶完成。
      "timeout_s": 180                   // 返回路线的总执行超时，单位 s。
    }
  ],

  "left_arm_actions": [                  // 左臂序列，与底盘、右臂独立推进。
    {
      "action_id": "l1",                 // 标签 l1：左臂调整 J2。
      "type": "move_j_partial",          // 只指定部分关节目标，由执行端用当前反馈补齐其余目标。
      "parameters": {
        "joint_positions_rad": {         // 键为关节名称，值为绝对目标角度，单位 rad。
          "J2": 1.0471975511965976        // J2 = +π/3 rad = +60°，不是在当前角度上再加 60°。
        }                                // 没写 J1：其目标保持动作开始时读到的值，不会自动回零。
      },
      "wait_for": [],                    // 第一动作无额外依赖，和 b1、r1 并行开始。
      "timeout_s": 30                    // 最多等待 30 s。
    }
  ],

  "right_arm_actions": [                 // 右臂按数组顺序执行；r5 后直接是 r7，编号跳号不影响执行。
    {
      "action_id": "r1",                 // 标签 r1：到达侧向抓取的准备位姿。
      "type": "move_p",                  // 指定 TCP 目标位姿，由 MoveIt 规划；TCP 路径不保证直线。
      "parameters": {
        "frame_id": "base_link",         // 此目标相对于机器人底盘，不是相对于固定桌子。
        "tcp_id": "default_tcp",         // 当前模型使用 right_gripper_base 作为工具参考点。
        "position_m": [0, -0.6, 0.95],    // 工具参考点的目标 [x,y,z]，单位 m，都是绝对坐标。
        "orientation_xyzw": [0.5, 0.5, -0.5, 0.5] // 单位四元数 [qx,qy,qz,qw]；不是关节角或欧拉角。
      },
      "wait_for": [],                    // 第一动作无额外依赖，可与 b1、l1 并行开始。
      "timeout_s": 30                    // 位姿规划与执行的超时，单位 s。
    },
    {
      "action_id": "r2",                 // 标签 r2：抓取前打开夹爪。
      "type": "gripper_open",            // 打开右夹爪；在此右臂序列中无需重复写控制资源。
      "parameters": {
        "opening_m": 0.09                // 两夹指总开口 90 mm，不是每个夹指移动 90 mm。
      },
      "wait_for": [],                    // 无额外依赖，但仍必须等本序列的 r1 成功。
      "timeout_s": 30                    // 等待夹爪打开完成的超时。
    },
    {
      "action_id": "r3",                 // 标签 r3：接近水瓶抓取位姿。
      "type": "move_l",                  // TCP 从当前位姿沿直线路径到目标；姿态也按目标处理。
      "parameters": {
        "frame_id": "odom",              // 使用固定场景坐标，目标不会随底盘移动。
        "tcp_id": "default_tcp",         // 同一个右夹爪工具参考点。
        "position_m": [0, -1.42, 0.72],   // 抓取时工具参考点的目标 [x,y,z]，单位 m。
        "orientation_xyzw": [0.5, 0.5, -0.5, 0.5], // 侧向夹瓶朝向，工具局部 +Z 指向场景 -Y。
        "touch_object": "water_bottle"   // 显式允许水瓶与指定右夹爪 link 接触，不放开桌面碰撞。
      },
      "wait_for": ["b1"],                // 同时满足：r2 成功，且底盘 b1 已停靠到位。
      "timeout_s": 30                    // 真正开始接近后计时，等待 b1 不计入。
    },
    {
      "action_id": "r4",                 // 标签 r4：夹住水瓶并确认仿真抓取。
      "type": "gripper_grasp",           // 执行端完成夹爪闭合与抓取确认。
      "parameters": {
        "grasp_profile": "water_bottle"  // 当前配置：总开口 70 mm，几何检查后建立 Gazebo 约束并同步附着物。
      },
      "wait_for": [],                    // 自动等 r3 成功；不是在任务开始时直接夹爪闭合。
      "timeout_s": 30                    // 闭合、仿真抓取确认与场景更新共用该超时。
    },
    {
      "action_id": "r5",                 // 标签 r5：抓住后抬起水瓶。
      "type": "move_l",                  // 使用直线运动抬起。
      "parameters": {
        "frame_id": "odom",              // 仍使用固定场景坐标。
        "tcp_id": "default_tcp",         // 同一个工具参考点。
        "position_m": [0, -1.42, 0.84],   // 相对抓取目标，x/y 不变，z 从 0.72 增到 0.84，即抬高 120 mm。
        "orientation_xyzw": [0.5, 0.5, -0.5, 0.5] // 保持抓取朝向。
      },
      "wait_for": [],                    // 自动等 r4 抓取成功；r5 成功后才允许 b2 移动。
      "timeout_s": 30                    // 抬起动作超时。
    },
    {
      "action_id": "r7",                 // 标签 r7：直接下降放置；原 r6 多余的 move_p 已删除。
      "type": "move_l",                  // 直接做 TCP 直线运动，不额外自由规划上方准备位姿。
      "parameters": {
        "frame_id": "odom",              // 左桌放置目标相对于固定场景。
        "tcp_id": "default_tcp",         // 同一个右夹爪工具参考点。
        "position_m": [0, 1.42, 0.726],   // 放置时的绝对工具目标；不是“移动 1.42 m、下降 0.726 m”。
        "orientation_xyzw": [-0.5, 0.5, 0.5, 0.5] // 对应底盘转过 180° 后的夹爪空间朝向。
      },
      "wait_for": ["b2"],                // 同时等本序列 r5 成功、底盘 b2 到达左桌。
      "timeout_s": 30                    // 放置下降动作超时。
    },
    {
      "action_id": "r8",                 // 标签 r8：松开水瓶。
      "type": "gripper_open",            // 当前仿真中先解除抓取约束、更新场景，再打开夹爪。
      "parameters": {
        "opening_m": 0.09                // 两夹指总开口重新打开到 90 mm。
      },
      "wait_for": [],                    // 自动等 r7 下降成功；r8 成功后才允许底盘 b3 返回。
      "timeout_s": 30                    // 释放与打开超时。
    }
  ]                                      // 三路的所有动作都成功后，整个任务才报告 SUCCEEDED。
}
// 工具参考点不是水瓶中心：当前夹持中心在工具局部 +Z 的 0.18 m 处。
// 抓取朝向下，工具 y=-1.42 m，对应夹持中心 y=-1.60 m。
// timeout_s 是动作开始后的最长等待时间，不是强制运动时长。
// 速度、加速度和底盘低速收尾规则当前由执行端设置，本文件没有这些字段。
