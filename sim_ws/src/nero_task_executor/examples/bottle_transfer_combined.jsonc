// 组合底盘运动的水瓶搬运任务；执行时使用同名 .json。
// b1/l1/r1 并行启动；各序列内部按数组顺序，action_id 只是标签。
// b1 到源桌；b2 从源桌直接边走边转 180° 到左桌；b3 放瓶后边走边转回原点。
// 新模式不支持 via。本示例没有原路线的中央停靠或原地转向阶段。
// 目标使用 odom 绝对坐标、米和弧度；从重置的默认桌面场景开始。
// 机械臂目标和跨序列依赖保持原任务；仅适用于此预设仿真场景。
{
  "version": 1,
  "task_id": "bottle_transfer_combined_001", // 新任务编号，与原分段搬运任务分别去重。
  "base_actions": [ // 底盘序列按数组顺序执行 b1 → b2 → b3。
    {
      "action_id": "b1",
      "type": "base_translate", // b1：保持开始时朝向，平移到源桌；从重置场景出发。
      "parameters": {
        "frame_id": "odom",
        "position_xy_m": [
          0,
          -0.8
        ]
      },
      "wait_for": [], // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
      "timeout_s": 180
    },
    {
      "action_id": "b2",
      "type": "base_move_and_rotate", // 位置和朝向沿共同进度变化，不再先移动后原地转向。
      "parameters": {
        "frame_id": "odom",
        "position_xy_m": [
          0,
          0.8
        ],
        "yaw_rad": 3.141592653589793
      },
      "wait_for": [ // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
        "r5"
      ],
      "timeout_s": 180
    },
    {
      "action_id": "b3",
      "type": "base_move_and_rotate", // 位置和朝向沿共同进度变化，不再先移动后原地转向。
      "parameters": {
        "frame_id": "odom",
        "position_xy_m": [
          0,
          0
        ],
        "yaw_rad": 0
      },
      "wait_for": [ // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
        "r8"
      ],
      "timeout_s": 180
    }
  ],
  "left_arm_actions": [ // 保持原任务：只把左臂 J2 设为 +60°，其他关节保持。
    {
      "action_id": "l1",
      "type": "move_j_partial",
      "parameters": {
        "joint_positions_rad": {
          "J2": 1.0471975511965976
        }
      },
      "wait_for": [], // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
      "timeout_s": 30
    }
  ],
  "right_arm_actions": [ // 保持原抓取、抬起、直接下降和松瓶动作。
    {
      "action_id": "r1",
      "type": "move_p",
      "parameters": {
        "frame_id": "base_link",
        "tcp_id": "default_tcp",
        "position_m": [
          0,
          -0.6,
          0.95
        ],
        "orientation_xyzw": [
          0.5,
          0.5,
          -0.5,
          0.5
        ]
      },
      "wait_for": [], // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
      "timeout_s": 30
    },
    {
      "action_id": "r2",
      "type": "gripper_open",
      "parameters": {
        "opening_m": 0.09
      },
      "wait_for": [], // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
      "timeout_s": 30
    },
    {
      "action_id": "r3",
      "type": "move_l",
      "parameters": {
        "frame_id": "odom",
        "tcp_id": "default_tcp",
        "position_m": [
          0,
          -1.42,
          0.72
        ],
        "orientation_xyzw": [
          0.5,
          0.5,
          -0.5,
          0.5
        ],
        "touch_object": "water_bottle"
      },
      "wait_for": [ // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
        "b1"
      ],
      "timeout_s": 30
    },
    {
      "action_id": "r4",
      "type": "gripper_grasp",
      "parameters": {
        "grasp_profile": "water_bottle"
      },
      "wait_for": [], // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
      "timeout_s": 30
    },
    {
      "action_id": "r5",
      "type": "move_l",
      "parameters": {
        "frame_id": "odom",
        "tcp_id": "default_tcp",
        "position_m": [
          0,
          -1.42,
          0.84
        ],
        "orientation_xyzw": [
          0.5,
          0.5,
          -0.5,
          0.5
        ]
      },
      "wait_for": [], // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
      "timeout_s": 30
    },
    {
      "action_id": "r7",
      "type": "move_l",
      "parameters": {
        "frame_id": "odom",
        "tcp_id": "default_tcp",
        "position_m": [
          0,
          1.42,
          0.726
        ],
        "orientation_xyzw": [
          -0.5,
          0.5,
          0.5,
          0.5
        ]
      },
      "wait_for": [ // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
        "b2"
      ],
      "timeout_s": 30
    },
    {
      "action_id": "r8",
      "type": "gripper_open",
      "parameters": {
        "opening_m": 0.09
      },
      "wait_for": [], // 跨序列依赖：b2 等 r5 抬瓶，b3 等 r8 松瓶，r3/r7 等底盘停靠。
      "timeout_s": 30
    }
  ]
}
