#!/usr/bin/env python3
"""Command the simulated AIR and compare independent Gazebo truth with wheel feedback."""
import argparse
import csv
import json
import math
import time
from pathlib import Path
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from gazebo_msgs.msg import ModelStates
from sensor_msgs.msg import JointState
from nav_msgs.msg import Odometry
from ranger_air_gazebo.kinematics import WHEELS, wrap


def yaw(q):
    return math.atan2(2*(q.w*q.z+q.x*q.y), 1-2*(q.y*q.y+q.z*q.z))


class Verify(Node):
    def __init__(self, folder, entity):
        super().__init__('air_motion_verification', parameter_overrides=[])
        self.folder = folder
        self.entity = entity
        self.truth = self.odom = self.joints = None
        self.command = (0., 0., 0.)
        self.pub = self.create_publisher(Twist, '/cmd_vel', 10)
        self.create_subscription(ModelStates, '/gazebo/model_states', self.on_truth, 10)
        self.create_subscription(JointState, '/joint_states', self.on_joints, 10)
        self.create_subscription(Odometry, '/odom', self.on_odom, 10)
        self.logfile = (folder / 'telemetry.csv').open('w', newline='')
        self.writer = csv.writer(self.logfile)
        self.writer.writerow(['wall_time', 'phase', 'cmd_vx', 'cmd_vy', 'cmd_wz',
                              'truth_x', 'truth_y', 'truth_yaw', 'truth_z',
                              'odom_x', 'odom_y', 'odom_yaw'] +
                             [w+'_steering' for w in WHEELS] + [w+'_wheel_rate' for w in WHEELS])

    def on_truth(self, m):
        if self.entity in m.name:
            i = m.name.index(self.entity)
            p, v = m.pose[i], m.twist[i]
            self.truth = (p.position.x, p.position.y, yaw(p.orientation), p.position.z,
                          math.hypot(v.linear.x, v.linear.y), abs(v.angular.z))

    def on_joints(self, m):
        p, v = dict(zip(m.name, m.position)), dict(zip(m.name, m.velocity))
        try:
            self.joints = ([p[w+'_steering_joint'] for w in WHEELS],
                           [v[w+'_wheel_joint'] for w in WHEELS])
        except KeyError:
            pass

    def on_odom(self, m):
        p = m.pose.pose
        self.odom = (p.position.x, p.position.y, yaw(p.orientation))

    def send(self, values):
        self.command = values
        msg = Twist()
        msg.linear.x, msg.linear.y, msg.angular.z = map(float, values)
        self.pub.publish(msg)

    def run_for(self, duration, phase, values=None):
        # Durations use simulation clock; wall deadline detects a paused/stalled simulation.
        start = self.get_clock().now().nanoseconds / 1e9
        deadline = time.monotonic() + max(30., duration*10)
        last_log = 0.
        while self.get_clock().now().nanoseconds/1e9 - start < duration:
            if time.monotonic() > deadline:
                raise RuntimeError('Simulation stopped or runs too slowly during '+phase)
            if values is not None:
                self.send(values)
            rclpy.spin_once(self, timeout_sec=.02)
            now = time.monotonic()
            if self.truth and self.odom and self.joints and now-last_log >= .05:
                self.writer.writerow([now, phase, *self.command, *self.truth[:4],
                                      *self.odom, *self.joints[0], *self.joints[1]])
                last_log = now


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--output-dir', required=True)
    parser.add_argument('--entity', default='ranger_air')
    args, ros_args = parser.parse_known_args()
    folder = Path(args.output_dir)
    folder.mkdir(parents=True, exist_ok=True)
    rclpy.init(args=ros_args)
    n = Verify(folder, args.entity)
    report = {'tests': [], 'passed': False}
    try:
        deadline = time.monotonic()+20
        while not (n.truth and n.odom and n.joints):
            rclpy.spin_once(n, timeout_sec=.1)
            if time.monotonic()>deadline:
                raise RuntimeError('Missing Gazebo truth, odometry or joint feedback')
        n.run_for(2., 'settle', (0., 0., 0.))
        cases = [('forward', (.15, 0., 0.)), ('backward', (-.15, 0., 0.)),
                 ('left', (0., .15, 0.)), ('right', (0., -.15, 0.)),
                 ('ccw', (0., 0., .4)), ('cw', (0., 0., -.4)),
                 ('combined', (.10, .05, .2))]
        for name, command in cases:
            before, odom_before = n.truth, n.odom
            n.run_for(5., name, command)
            n.run_for(1.5, name+'_stop', (0., 0., 0.))
            after = n.truth
            dx, dy = after[0]-before[0], after[1]-before[1]
            x = math.cos(before[2])*dx + math.sin(before[2])*dy
            y = -math.sin(before[2])*dx + math.cos(before[2])*dy
            angle = wrap(after[2]-before[2])
            stopped = max(abs(v) for v in n.joints[1]) < .1 and after[4]<.02 and after[5]<.03
            if name in ['forward', 'backward']:
                passed = x * math.copysign(1, command[0]) > .3 and abs(y)<.08 and abs(angle)<.12
            elif name in ['left', 'right']:
                passed = y * math.copysign(1, command[1]) > .3 and abs(x)<.08 and abs(angle)<.12
            elif name in ['ccw', 'cw']:
                passed = angle * math.copysign(1, command[2]) > .7 and math.hypot(x, y)<.10
            else:
                passed = math.hypot(x,y)>.2 and angle>.3
            odom_delta = (n.odom[0]-odom_before[0], n.odom[1]-odom_before[1])
            error = math.hypot(odom_delta[0]-dx, odom_delta[1]-dy)
            yaw_error = abs(wrap((n.odom[2]-odom_before[2])-angle))
            entry = {'name': name, 'command': command, 'body_dx': x, 'body_dy': y,
                     'delta_yaw': angle, 'stopped': stopped, 'odom_position_error': error,
                     'odom_yaw_error': yaw_error, 'passed': bool(passed and stopped and error<.12 and yaw_error<.15)}
            report['tests'].append(entry)
            print(json.dumps(entry), flush=True)
        n.run_for(2., 'timeout_drive', (.15, 0., 0.))
        n.run_for(1.5, 'timeout_no_messages')
        stopped = max(abs(v) for v in n.joints[1]) < .1 and n.truth[4]<.02
        report['tests'].append({'name':'command_timeout', 'wheel_rates':n.joints[1],
                                'body_speed':n.truth[4], 'passed':bool(stopped)})
        report['passed'] = all(t['passed'] for t in report['tests'])
    except Exception as error:
        report['error'] = str(error)
        raise
    finally:
        n.send((0., 0., 0.))
        n.logfile.close()
        (folder/'report.json').write_text(json.dumps(report, indent=2)+'\n')
        n.destroy_node()
        rclpy.shutdown()
    if not report['passed']:
        raise SystemExit(1)


if __name__ == '__main__':
    main()
