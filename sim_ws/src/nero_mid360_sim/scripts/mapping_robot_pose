#!/usr/bin/env python3
"""Display-only estimated world→robot root; never changes simulation or LIO input."""
import math


def multiply(a, b):
    x,y,z,w=a; X,Y,Z,W=b
    return (w*X+x*W+y*Z-z*Y, w*Y-x*Z+y*W+z*X,
            w*Z+x*Y-y*X+z*W, w*W-x*X-y*Y-z*Z)


def base_pose(position, orientation, mount_xyz, mount_rpy):
    r,p,y=[v/2 for v in mount_rpy]
    sr,cr,sp,cp,sy,cy=math.sin(r),math.cos(r),math.sin(p),math.cos(p),math.sin(y),math.cos(y)
    mount_q=(sr*cp*cy-cr*sp*sy, cr*sp*cy+sr*cp*sy,
             cr*cp*sy-sr*sp*cy, cr*cp*cy+sr*sp*sy)
    q=multiply(orientation, (-mount_q[0],-mount_q[1],-mount_q[2],mount_q[3]))
    length=math.sqrt(sum(v*v for v in q));q=tuple(v/length for v in q)
    offset=multiply(multiply(q,(*mount_xyz,0.)),(-q[0],-q[1],-q[2],q[3]))[:3]
    return tuple(p-d for p,d in zip(position,offset)),q


class LiftHistory:
    def __init__(self):
        from collections import deque
        self.rows = deque()

    def add(self, t, height):
        if self.rows and t < self.rows[-1][0]: self.rows.clear()
        if self.rows and t == self.rows[-1][0]: self.rows.pop()
        self.rows.append((t, height))
        while self.rows and t-self.rows[0][0] > 3_000_000_000: self.rows.popleft()

    def sample(self, t):
        if not self.rows or t < self.rows[0][0] or t > self.rows[-1][0]: return None
        previous = self.rows[0]
        for row in self.rows:
            if row[0] >= t:
                if row[0] == previous[0]: return row[1]
                if row[0]-previous[0] > 100_000_000: return None
                a = (t-previous[0])/(row[0]-previous[0])
                return previous[1]+a*(row[1]-previous[1])
            previous = row
        return previous[1]


def main():
    import rclpy
    from rclpy.node import Node
    from nav_msgs.msg import Odometry
    from sensor_msgs.msg import JointState
    from rclpy.qos import qos_profile_sensor_data
    from collections import deque
    import time
    from geometry_msgs.msg import TransformStamped
    from tf2_ros import TransformBroadcaster

    class RobotPose(Node):
        def __init__(self):
            super().__init__('mapping_robot_pose')
            self.xyz=list(self.declare_parameter('mount_xyz',[0.,0.,0.]).value)
            self.rpy=list(self.declare_parameter('mount_rpy',[0.,0.,0.]).value)
            self.moving = bool(self.declare_parameter('moving_mount', False).value)
            self.history = LiftHistory()
            self.pending = deque(maxlen=20)
            self.joints_sub = self.create_subscription(JointState, '/joint_states', self.joints, qos_profile_sensor_data)
            self.timer = self.create_timer(.01, self.flush)
            self.tf=TransformBroadcaster(self)
            self.sub=self.create_subscription(Odometry,'/lio/odom',self.update,10)

        def joints(self, msg):
            if 'upper_body_lift_joint' in msg.name:
                i = msg.name.index('upper_body_lift_joint')
                self.history.add(msg.header.stamp.sec*10**9+msg.header.stamp.nanosec, msg.position[i])

        def update(self,msg):
            if self.moving:
                self.pending.append((msg, time.monotonic()))
                self.flush()
            else:
                self.publish(msg, 0.)

        def flush(self):
            while self.pending:
                msg, received = self.pending[0]
                t = msg.header.stamp.sec*10**9+msg.header.stamp.nanosec
                height = self.history.sample(t)
                if height is None:
                    if time.monotonic()-received > 2:
                        self.pending.popleft()
                        self.get_logger().warning('No lift feedback at LIO timestamp; display pose dropped')
                        continue
                    return
                self.pending.popleft()
                self.publish(msg, height)

        def publish(self, msg, height):
            pose=msg.pose.pose
            mount_xyz = self.xyz.copy(); mount_xyz[2] += height
            p,q=base_pose((pose.position.x,pose.position.y,pose.position.z),
                (pose.orientation.x,pose.orientation.y,pose.orientation.z,pose.orientation.w),mount_xyz,self.rpy)
            transform=TransformStamped();transform.header=msg.header
            transform.child_frame_id='lio_robot/base_link'
            transform.transform.translation.x,transform.transform.translation.y,transform.transform.translation.z=p
            transform.transform.rotation.x,transform.transform.rotation.y,transform.transform.rotation.z,transform.transform.rotation.w=q
            self.tf.sendTransform(transform)

    rclpy.init();node=RobotPose()
    try:rclpy.spin(node)
    except KeyboardInterrupt:pass
    finally:
        node.destroy_node()
        if rclpy.ok():rclpy.shutdown()


if __name__=='__main__':main()
