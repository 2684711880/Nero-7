<robot name="mobile_dual_nero">
  <group name="left_arm">
    <chain base_link="left_arm_base" tip_link="left_gripper_base" />
  </group>
  <group name="left_gripper">
    <joint name="left_gripper_joint1" />
    <joint name="left_gripper_joint2" />
  </group>
  <end_effector name="left_eef" parent_link="left_gripper_base" group="left_gripper" parent_group="left_arm" />
  <group name="right_arm">
    <chain base_link="right_arm_base" tip_link="right_gripper_base" />
  </group>
  <group name="right_gripper">
    <joint name="right_gripper_joint1" />
    <joint name="right_gripper_joint2" />
  </group>
  <end_effector name="right_eef" parent_link="right_gripper_base" group="right_gripper" parent_group="right_arm" />
  <group name="both_arms">
    <group name="left_arm" />
    <group name="right_arm" />
  </group>
