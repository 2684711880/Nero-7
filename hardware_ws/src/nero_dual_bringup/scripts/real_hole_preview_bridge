#!/usr/bin/env python3
from pathlib import Path
import runpy,sys
root=Path(__file__).resolve()
while not (root/'scripts/real_hole_preview_bridge.py').exists():
    if root==root.parent:raise RuntimeError('Cannot locate NERO workspace')
    root=root.parent
sys.path.insert(0,str(root/'scripts'))
runpy.run_path(str(root/'scripts/real_hole_preview_bridge.py'),run_name='__main__')
