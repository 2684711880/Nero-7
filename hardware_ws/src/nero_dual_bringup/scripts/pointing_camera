#!/usr/bin/env python3
from pathlib import Path
import runpy
root=Path(__file__).resolve()
while not (root/'scripts/handeye_rviz_inputs.py').exists():
    if root==root.parent:raise RuntimeError('Cannot locate NERO workspace')
    root=root.parent
import sys
sys.path.insert(0,str(root/'scripts'))
runpy.run_path(str(root/'scripts/handeye_rviz_inputs.py'),run_name='__main__')
